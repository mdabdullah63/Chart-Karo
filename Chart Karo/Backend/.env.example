# ---------- Core ----------
NODE_ENV=production
PORT=3000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chatkaro?retryWrites=true&w=majority

# Long random strings (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me-too

# ---------- URLs ----------
# Public URL of the app. If frontend + backend are deployed together (recommended) this is just your app URL.
# Several origins can be comma separated.
CLIENT_URL=https://your-app.onrender.com
# Public URL of this API (used to build OAuth callback URLs). Render sets RENDER_EXTERNAL_URL automatically.
SERVER_URL=https://your-app.onrender.com

# ---------- Cookies ----------
# lax  -> frontend and backend share one domain (recommended)
# none -> frontend and backend are on different domains (needs HTTPS; Safari may still block it)
COOKIE_SAMESITE=lax

# ---------- Email (password reset OTP) ----------
# Gmail: enable 2FA, then create an "App password"
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=you@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=Chat Karo

# ---------- Social login (optional - buttons are hidden when keys are missing) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Callback URLs default to SERVER_URL + /auth/<provider>/callback. Override only if needed:
# GOOGLE_CALLBACK_URL=
# GITHUB_CALLBACK_URL=
# FACEBOOK_CALLBACK_URL=
